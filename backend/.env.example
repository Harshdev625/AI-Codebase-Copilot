APP_NAME=AI Codebase Copilot API
# Set APP_ENV=production when deploying. Triggers secure-secrets enforcement.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Set LOG_FORMAT=json for structured logging in production (e.g. with Datadog/Loki).
LOG_FORMAT=text

# ── CORS ────────────────────────────────────────────────────────────────────
# REQUIRED in production: update to your actual frontend domain.
# Multiple origins: comma-separated, e.g. https://app.example.com,https://www.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
OLLAMA_CHAT_MODEL=tinyllama:latest
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_CHAT_TIMEOUT_SECONDS=15
OLLAMA_PLAN_TIMEOUT_SECONDS=240
OLLAMA_ACT_TIMEOUT_SECONDS=600
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=600

# ── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=code_chunks

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=300

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aicc
POSTGRES_USER=postgres
# REQUIRED in production: change this to a strong password
POSTGRES_PASSWORD=mypassword

# PgAdmin (runs via Podman on port 5050)
# URL: http://localhost:5050  |  Login: admin@aicc.dev / admin

# ── Indexing / RAG ──────────────────────────────────────────────────────────
# Must match selected embedding model output dimension.
# mxbai-embed-large = 1024 | nomic-embed-text = 768 | text-embedding-3-small = 1536
VECTOR_DIM=1024
MAX_RETRIEVAL_K=12
REPO_CACHE_DIR=.repo_cache
# Clones are stored at backend/.repo_cache/<repo-slug>/ (absolute path, not cwd-dependent).
# Keep cloned repos on disk after indexing (required for file explorer, patches, diffs).
# Full re-index wipes the cache at job start, then clones fresh. Set false only in CI.
REPO_CACHE_PERSIST=true
MAX_INDEX_FILE_SIZE_BYTES=1000000
INDEXING_TIMEOUT_SECONDS=1800
INDEXING_STALL_TIMEOUT_SECONDS=300

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret with: openssl rand -hex 32
# The server will WARN in development and REFUSE to start in production if this is weak.
JWT_SECRET_KEY=change-me-in-production
JWT_ISSUER=ai-codebase-copilot
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=28800

# ── Admin registration ───────────────────────────────────────────────────────
# When empty, admin self-registration via shared secret is DISABLED (safe default).
# Bootstrap: generate with `openssl rand -hex 32`, set here, create first admin at
# /admin/register, then UNSET this value. Additional admins should use invite links
# from the admin dashboard (Users & Access → Admin Invites).
# Never commit this value. Always use HTTPS in production.
ADMIN_REGISTRATION_SECRET_KEY=
